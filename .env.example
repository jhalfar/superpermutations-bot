# Copy to .env, fill in, chmod 600 .env. Never commit .env.
# Values below are the defaults; lines that are commented out are optional.

# paste the token here, chmod 600 .env, never commit
DISCORD_TOKEN=

# channel id for "new record" announcements (none = no announcements)
#SUPERPERM_CHANNEL=
# 1 = keep the records table as the last message of that channel (the bot edits it, or deletes its old one and posts it
# again under a new announcement); the message id is kept in board.json next to the records table
#SUPERPERM_BOARD=0
# roles pinged by a new record, by n: N:ROLE_ID or LO-HI:ROLE_ID, comma-separated (only that role is pinged; the role must
# be mentionable, or the bot needs Mention @everyone, @here and All Roles)
#SUPERPERM_N_ROLES=1-6:111,7:222,15-99:333
# channel id for the audit copy of private checks (none = no copy). Who can read it is decided by the channel's permissions
# (give it to server admins only). Details of the copies open only for members with Administrator.
#SUPERPERM_AUDIT_CHANNEL=
# per-user settings (the default visibility of a user's checks); default: settings.json next to the records table
# (Docker: /data/settings.json)
#SUPERPERM_SETTINGS=
# history of checks (SQLite): time, user, file name, n, length, SHA-256, result; never the file. Default history.sqlite next to
# the records table (Docker: /data/history.sqlite). Rows older than SUPERPERM_HISTORY_DAYS are deleted at start and once a day.
#SUPERPERM_HISTORY=
#SUPERPERM_HISTORY_DAYS=180
# role id given to the submitter of a new record (none = no role; the bot's own role must be above it)
#SUPERPERM_CONTRIBUTOR_ROLE=
# only members with this role may add words to the records table (none = everyone may; anyone can still check)
#SUPERPERM_SUBMIT_ROLE=

# memory limit of one check pass in GB; keep it about 1.5 GB below mem_limit in compose.yaml
SUPERPERM_MEM_GB=14
# refuse a job that would need more passes than this to fit into SUPERPERM_MEM_GB
SUPERPERM_MAX_SHARDS=8
# refuse larger n before any work (14 is the maximum)
SUPERPERM_MAX_N=14
# assumed speed of one pass, million letters per second (used for time estimates and kill limits)
SUPERPERM_MBPS=30
# refuse a job whose estimated time is longer; also the hard limit for a whole job
SUPERPERM_MAX_HOURS=6
# jobs waiting per lane
SUPERPERM_QUEUE=6

# the table of records; the Docker image sets /data/records.json (a volume), do not change it there
#SUPERPERM_RECORDS=bot/records.json
# Windows only: path of guard.py (memory limit); default is checker/guard.py
#SUPERPERM_GUARD=checker/guard.py
# folders of the built programs and their C sources; defaults bin/ and gens/ in the repository root
#SUPERPERM_BIN=bin
#SUPERPERM_SRC=gens
# Python used by scripts/run_bot.ps1 / scripts/run_bot.sh (default: python on Windows, python3 elsewhere); not used in Docker
#SUPERPERM_PYTHON=python
